{
  "name": "@endge/nova-datatable",
  "type": "module",
  "version": "0.16.8",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/nova-datatable.js"
    }
  },
  "module": "./dist/nova-datatable.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "vite build --watch",
    "dev:watch": "vite build --watch",
    "build": "vue-tsc --noCheck && vite build",
    "test": "vitest run --config vite.config.ts",
    "bench": "vitest bench --run src/test/*.bench.ts --config vite.config.ts",
    "lint-check": "eslint . --cache",
    "lint-fix": "eslint . --fix --cache"
  },
  "dependencies": {
    "@endge/nova": "^0.13.6",
    "@endge/nova-ui-kit": "^0.10.9",
    "@endge/nova-vue": "^0.3.3",
    "@endge/utils": "^0.25.0",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@endge/nova-compiler": "^0.6.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/language-core": "^3.3.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.9.1",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  }
}
