{
  "name": "@endge/nova-datatable",
  "private": false,
  "version": "0.7.2",
  "type": "module",
  "module": "./dist/nova-datatable.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/nova-datatable.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "vite build --watch",
    "dev:watch": "vite build --watch",
    "build": "vue-tsc --noCheck && vite build",
    "test": "vitest run --config vite.config.ts",
    "bench": "vitest bench --run src/test/*.bench.ts --config vite.config.ts"
  },
  "dependencies": {
    "@endge/nova": "workspace:*",
    "@endge/nova-ui-kit": "workspace:*",
    "@endge/nova-vue": "workspace:*",
    "@endge/utils": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@endge/nova-compiler": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.8"
  }
}
